{
  "name": "@local/dsh-antigravity-pool",
  "version": "2.2.0",
  "private": true,
  "type": "module",
  "description": "Multi-account Antigravity OAuth pool manager for DSH Superagent. Rotates Google OAuth accounts, auto-cools on quota errors, syncs the active grant into .credentials.yaml. Reads ANTIGRAVITY_CLIENT_ID and ANTIGRAVITY_CLIENT_SECRET from environment variables; no credentials are stored in this repository.",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./pool-core": "./pool-core.mjs",
    "./package.json": "./package.json",
    "./client": "./client.js",
    "./settings-routes": "./settings-routes.mjs"
  },
  "files": [
    "index.js",
    "pool-core.mjs",
    "settings-routes.mjs",
    "client.js",
    "cordis.patch.yml",
    "test-pool.mjs",
    ".env.example",
    "README.md",
    "ui.html"
  ],
  "scripts": {
    "test": "node test-pool.mjs"
  },
  "dependencies": {
    "yaml": "^2.6.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-connection": "^0.2.1-rc.5"
  }
}
