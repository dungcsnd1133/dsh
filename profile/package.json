    "@bangbang-03/dsh-memory": "0.7.0",
    "@local/dsh-media-play": "link:D:/dsh/plugins/dsh-media-play",
    "@local/hide-session-memory-hud": "link:D:/dsh/plugins/hide-session-memory-hud",
    "brooks-lint": "1.9.1",
