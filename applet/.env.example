# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# XAI_API_KEY: Used by xAI provider (grok-4.7) and dsh-video-watch speech-to-text.
XAI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ANTIGRAVITY_CLIENT_ID / ANTIGRAVITY_CLIENT_SECRET:
# Google OAuth client used by the Antigravity account pool. Create your own
# OAuth client in Google Cloud Console; do not commit real values here.
ANTIGRAVITY_CLIENT_ID=""
ANTIGRAVITY_CLIENT_SECRET=""
